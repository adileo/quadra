test "a new customer":
    let anna = Customer(name="Anna Rossi", email="anna@example.com")
    expect anna.name == "Anna Rossi"
    expect anna.city == none

test "new products are active":
    let mug = Product(code="MUG-01", name="Espresso mug")
    expect mug.active
    expect Product.count() == 1
