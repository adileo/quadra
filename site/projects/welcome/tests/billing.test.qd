from billing import Customer, Invoice, InvoiceLine, Payment

fixture demo:
    let acme = Customer(name="ACME Inc.", credit_limit=5000.00 EUR)
    let globex = Customer(name="Globex", credit_limit=1000.00 EUR)

test "an invoice is paid when its payments cover it":
    use demo
    let inv = Invoice(customer=acme, lines=[InvoiceLine(description="Consulting", qty=2, price=500.00 EUR)])
    expect inv.total == 1000.00 EUR
    inv.post()
    expect acme.open_balance == 1000.00 EUR
    Payment(invoice=inv, amount=1000.00 EUR)
    expect inv.state is Paid
    expect acme.open_balance == 0

test "the credit limit is a rule, not a hope":
    use demo
    expect_error "Over the credit limit":
        Invoice(customer=globex, lines=[InvoiceLine(description="Servers", qty=3, price=900.00 EUR)])

test "money keeps its currency":
    expect_compile_error "cannot add Money<EUR> and Money<USD>":
        let x = 10.00 EUR + 5.00 USD
