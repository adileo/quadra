# What we sell, and who we buy it from.

entity Category:
    name: Text unique
    products: [Product]                     # the inverse of Product.category


entity Product:
    sku: Code unique                        # was `code`: see migrations/2026-12-01_sku_and_origin.qd
    name: Text
    description: Text?
    origin: Code where c => c.len() == 2    # country of origin (ISO 3166), required for shipping abroad
    category: Category?
    active: Bool default true
    uom: Uom default pcs
    price: Price<EUR, uom>
    cost: Price<EUR, uom> default 0
    weight: Qty<kg>?
    vat: Percent where v => v in {4%, 10%, 22%} default 22%
    tags: {Tag}                             # a set: many-to-many

    offers: [SupplierOffer]
    suppliers: {Supplier} through SupplierOffer

    label = f"{sku} · {name}"
    margin = price - cost
    best_offer = offers.sort_by(o => o.cost).first()

    fn price_for(qty: Qty<uom>) -> Money<EUR>:
        return (qty * price).round()


entity Tag:
    name: Text unique
    products: {Product} via tags


entity Supplier:
    name: Text unique
    email: Email?
    offers: [SupplierOffer]


# Many-to-many with data of its own: what a supplier charges us for a product.
entity SupplierOffer:
    product: Product
    supplier: Supplier
    cost: Price<EUR, product.uom>
    lead_time: Duration where >= 1 day default 7 days
    unique (product, supplier)
