# The formats read and written as text: what another system sends, what it expects back.

test "a CSV export is read row by row":
    let rows = PosRow.parse_rows("NEGOZIO;DATA;ARTICOLO;DESCRIZIONE;QTA;IMPORTO;PAGAMENTO;RESO;NOTE;CASSA\r\nMI01;27/11/2026;A-100;\"Penna; blu\";2;3,50;Cash;N;;4\r\n\r\nMI01;27/11/2026;A-200;\"Quaderno \"\"A4\"\"\";1;1,20;Card;S;\"difettoso,\nsostituito\";4\r\n")
    expect rows.count() == 2
    expect rows.map(r => r.amount) == [3.50, 1.20]
    expect rows.map(r => r.description) == ["Penna; blu", "Quaderno \"A4\""]
    expect rows.map(r => r.note) == [none, "difettoso,\nsostituito"]
    expect rows.all(r => r.day == 2026-11-27)
    expect rows.single(r => r.refund).payment is Card
    expect takings(rows) == 2.30

test "a CSV file is written with its header, quoted where it must be":
    let rows = [
        PosRow(store="MI01", day=2026-11-27, sku="A-100", description="Penna; blu", quantity=2, amount=3.5, payment=Cash, refund=false),
        PosRow(store="MI01", day=2026-11-28, sku="A-200", description="Quaderno \"A4\"", quantity=-1, amount=-1.2, payment=Card, refund=true, note="reso"),
    ]
    expect rows.csv() == "NEGOZIO;DATA;ARTICOLO;DESCRIZIONE;QTA;IMPORTO;PAGAMENTO;RESO;NOTE\r\nMI01;27/11/2026;A-100;\"Penna; blu\";2;3,50;Cash;N;\r\nMI01;28/11/2026;A-200;\"Quaderno \"\"A4\"\"\";-1;-1,20;Card;S;reso\r\n"
    expect PosRow.parse_rows(rows.csv()) == rows

test "an empty list of rows is the header alone":
    let rows = PosRow.parse_rows("NEGOZIO;DATA;ARTICOLO;DESCRIZIONE;QTA;IMPORTO;PAGAMENTO;RESO;NOTE\r\n")
    expect rows.count() == 0
    expect rows.csv() == "NEGOZIO;DATA;ARTICOLO;DESCRIZIONE;QTA;IMPORTO;PAGAMENTO;RESO;NOTE\r\n"

test "a formula in a text cell is neutralized when written":
    let rows = [PosRow(store="MI01", day=2026-11-27, sku="A-1", description="=HYPERLINK(\"http://x\")", quantity=1, amount=1, payment=Cash, refund=false, note="@SUM(A1)")]
    expect rows.csv() == "NEGOZIO;DATA;ARTICOLO;DESCRIZIONE;QTA;IMPORTO;PAGAMENTO;RESO;NOTE\r\nMI01;27/11/2026;A-1;\"'=HYPERLINK(\"\"http://x\"\")\";1;1,00;Cash;N;'@SUM(A1)\r\n"
    expect PosRow.parse_rows(rows.csv()) == rows

test "a row that does not fit says its line and column":
    expect_error "line 3, column `IMPORTO`: a number with `,` before the decimals was expected, not `3.50`":
        PosRow.parse_rows("NEGOZIO;DATA;ARTICOLO;DESCRIZIONE;QTA;IMPORTO;PAGAMENTO;RESO;NOTE\r\nMI01;27/11/2026;A-1;x;1;1,00;Cash;N;\r\nMI01;27/11/2026;A-1;x;1;3.50;Cash;N;\r\n")
    expect_error "line 2, column `DATA`: a date (27/11/2026) was expected, not `2026-11-27`":
        PosRow.parse_rows("NEGOZIO;DATA;ARTICOLO;DESCRIZIONE;QTA;IMPORTO;PAGAMENTO;RESO;NOTE\r\nMI01;2026-11-27;A-1;x;1;1,00;Cash;N;\r\n")
    expect_error "line 2, column `PAGAMENTO`: `Cheque` is not a value of Payment (Cash, Card, Voucher)":
        PosRow.parse_rows("NEGOZIO;DATA;ARTICOLO;DESCRIZIONE;QTA;IMPORTO;PAGAMENTO;RESO;NOTE\r\nMI01;27/11/2026;A-1;x;1;1,00;Cheque;N;\r\n")
    expect_error "line 2, column `RESO`: missing (the row has 7 cells)":
        PosRow.parse_rows("NEGOZIO;DATA;ARTICOLO;DESCRIZIONE;QTA;IMPORTO;PAGAMENTO;RESO;NOTE\r\nMI01;27/11/2026;A-1;x;1;1,00;Cash\r\n")
    expect_error "the header has no column `RESO`":
        PosRow.parse_rows("NEGOZIO;DATA;ARTICOLO;DESCRIZIONE;QTA;IMPORTO;PAGAMENTO\r\n")
    expect_error "line 2: a quote is never closed":
        PosRow.parse_rows("NEGOZIO;DATA;ARTICOLO;DESCRIZIONE;QTA;IMPORTO;PAGAMENTO;RESO;NOTE\r\nMI01;27/11/2026;A-1;\"x;1;1,00;Cash;N;\r\n")

test "a latin1 file refuses what latin1 cannot hold":
    let ok = [PosRow(store="MI01", day=2026-11-27, sku="A-1", description="Caffè", quantity=1, amount=1, payment=Cash, refund=false)]
    expect ok.csv().contains("Caffè")
    let euro = [PosRow(store="MI01", day=2026-11-27, sku="A-1", description="Buono 5€", quantity=1, amount=5, payment=Voucher, refund=false)]
    expect_error "row 1, column `DESCRIZIONE`: `€` cannot be written in latin1":
        euro.csv()

test "a decimal with more decimals than declared is refused, not rounded":
    let rows = [PosRow(store="MI01", day=2026-11-27, sku="A-1", description="x", quantity=1, amount=1.005, payment=Cash, refund=false)]
    expect_error "1.005 has more than 2 decimals":
        rows.csv()

test "a CSV without a header: columns by position":
    let rows = Movement.parse_rows("IT01,,12.50\nIT02,R-7,-3\n")
    expect rows.map(r => r.account) == ["IT01", "IT02"]
    expect rows.map(r => r.reference) == [none, "R-7"]
    expect rows.map(r => r.amount) == [12.50, -3]
    expect rows.csv() == "IT01,,12.5\r\nIT02,R-7,-3\r\n"

test "an XML invoice is read with its namespaces":
    let inv = Invoice.parse("""
        <?xml version="1.0" encoding="UTF-8"?>
        <Invoice xmlns="urn:example:invoice" xmlns:b="urn:example:basic" xmlns:a="urn:example:aggregate">
          <b:ID>FT-2026/118</b:ID>
          <b:IssueDate>2026-11-27</b:IssueDate>
          <b:DocumentCurrencyCode>EUR</b:DocumentCurrencyCode>
          <a:AccountingSupplierParty><a:Party><b:Name>Rossi &amp; Figli</b:Name></a:Party></a:AccountingSupplierParty>
          <a:LegalMonetaryTotal><b:PayableAmount currencyID="EUR">122.00</b:PayableAmount></a:LegalMonetaryTotal>
          <a:InvoiceLine>
            <b:ID>1</b:ID>
            <b:InvoicedQuantity unitCode="H87">2</b:InvoicedQuantity>
            <b:LineExtensionAmount>80.00</b:LineExtensionAmount>
            <a:Item><b:Name><![CDATA[Penne <blu>]]></b:Name></a:Item>
          </a:InvoiceLine>
          <a:InvoiceLine>
            <b:ID>2</b:ID>
            <b:InvoicedQuantity unitCode="KGM">1.5</b:InvoicedQuantity>
            <b:LineExtensionAmount>20</b:LineExtensionAmount>
            <a:Item><b:Name>Carta</b:Name></a:Item>
          </a:InvoiceLine>
        </Invoice>
        """)
    expect inv.number == "FT-2026/118"
    expect inv.supplier == "Rossi & Figli"
    expect inv.note == none
    expect inv.total == 122
    expect inv.lines.map(l => l.name) == ["Penne <blu>", "Carta"]
    expect inv.lines.map(l => l.unit) == ["H87", "KGM"]
    expect inv.lines.sum(l => l.amount) == 100

test "an XML invoice is written and read back":
    let inv = Invoice(number="FT-1", issued=2026-11-27, currency="EUR", supplier="A < B", total=10, total_currency="EUR", lines=[InvoiceLine(id=1, name="x", quantity=1, unit="H87", amount=10)])
    expect inv.xml() == "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Invoice xmlns=\"urn:example:invoice\" xmlns:cbc=\"urn:example:basic\" xmlns:cac=\"urn:example:aggregate\"><cbc:ID>FT-1</cbc:ID><cbc:IssueDate>2026-11-27</cbc:IssueDate><cbc:DocumentCurrencyCode>EUR</cbc:DocumentCurrencyCode><cac:AccountingSupplierParty><cac:Party><cbc:Name>A &lt; B</cbc:Name></cac:Party></cac:AccountingSupplierParty><cac:LegalMonetaryTotal><cbc:PayableAmount currencyID=\"EUR\">10.00</cbc:PayableAmount></cac:LegalMonetaryTotal><cac:InvoiceLine><cbc:ID>1</cbc:ID><cbc:InvoicedQuantity unitCode=\"H87\">1</cbc:InvoicedQuantity><cbc:LineExtensionAmount>10.00</cbc:LineExtensionAmount><cac:Item><cbc:Name>x</cbc:Name></cac:Item></cac:InvoiceLine></Invoice>"
    expect Invoice.parse(inv.xml()) == inv

test "an XML document that does not fit says where":
    expect_error "Invoice/cac:InvoiceLine[1]/cbc:InvoicedQuantity: a number was expected, not `two`":
        Invoice.parse("<Invoice xmlns=\"urn:example:invoice\" xmlns:cbc=\"urn:example:basic\" xmlns:cac=\"urn:example:aggregate\"><cbc:ID>1</cbc:ID><cbc:IssueDate>2026-11-27</cbc:IssueDate><cbc:DocumentCurrencyCode>EUR</cbc:DocumentCurrencyCode><cac:AccountingSupplierParty><cac:Party><cbc:Name>x</cbc:Name></cac:Party></cac:AccountingSupplierParty><cac:LegalMonetaryTotal><cbc:PayableAmount currencyID=\"EUR\">1</cbc:PayableAmount></cac:LegalMonetaryTotal><cac:InvoiceLine><cbc:ID>1</cbc:ID><cbc:InvoicedQuantity unitCode=\"H87\">two</cbc:InvoicedQuantity><cbc:LineExtensionAmount>1</cbc:LineExtensionAmount><cac:Item><cbc:Name>x</cbc:Name></cac:Item></cac:InvoiceLine></Invoice>")
    expect_error "Invoice/cbc:IssueDate: missing":
        Invoice.parse("<Invoice xmlns=\"urn:example:invoice\" xmlns:cbc=\"urn:example:basic\"><cbc:ID>1</cbc:ID></Invoice>")
    expect_error "the root element is `Order`":
        Invoice.parse("<Order xmlns=\"urn:example:invoice\"/>")

test "a DTD is refused: no external entities, no billion laughs":
    expect_error "a DTD (`<!DOCTYPE …>`) is refused":
        Invoice.parse("<?xml version=\"1.0\"?>\n<!DOCTYPE Invoice [<!ENTITY xxe SYSTEM \"file:///etc/passwd\">]>\n<Invoice xmlns=\"urn:example:invoice\">&xxe;</Invoice>")
    expect_error "`&lol;` is not an entity of XML":
        Invoice.parse("<Invoice xmlns=\"urn:example:invoice\">&lol;</Invoice>")

test "a fixed-width line is read by its columns":
    let rows = CbiRow.parse_rows("610000012345672711260000000001250CPagamento fattura 118         0000004711\r\n610000099999992811260000012345678DStipendi\n")
    expect rows.count() == 2
    expect rows.map(r => r.amount) == [12.50, 123456.78]
    expect rows.map(r => r.value_date) == [2026-11-27, 2026-11-28]
    expect rows.map(r => r.description) == ["Pagamento fattura 118", "Stipendi"]
    expect rows.map(r => r.cro) == [4711, none]

test "a fixed-width file is written padded":
    let rows = [CbiRow(kind="61", account="1234567", value_date=2026-11-27, amount=12.5, sign="C", description="Fattura 118", cro=42)]
    expect rows.fixed() == "611234567     2711260000000001250CFattura 118                   0000000042\r\n"
    expect CbiRow.parse_rows(rows.fixed()) == rows

test "what does not fit in its columns is an error, never cut":
    let long = [CbiRow(kind="61", account="1", value_date=2026-11-27, amount=1, sign="C", description="a description longer than thirty columns")]
    expect_error "row 1, columns 35..64 (`description`): `a description longer than thirty columns` is 40 characters, the columns hold 30":
        long.fixed()
    let big = [CbiRow(kind="61", account="1", value_date=2026-11-27, amount=100000000000, sign="C", description="x")]
    expect_error "row 1, columns 21..33 (`amount`): 10000000000000 does not fit in 13 columns":
        big.fixed()
    expect_error "line 1, columns 21..33 (`amount`): digits were expected, not `0000000012,50`":
        CbiRow.parse_rows("610000012345672711260000000012,50C")

test "the compiler refuses what a format cannot hold":
    expect_compile_error "a cell of CSV holds one value, not a list":
        record Bad from csv:
            tags: [Text]
    expect_compile_error "a field of a fixed-width line says its columns":
        record Bad from fixed:
            name: Text
    expect_compile_error "columns 5..12 overlap those of `a` (1..10)":
        record Bad from fixed:
            a: Text at "1..10"
            b: Text at "5..12"
    expect_compile_error "says how many of its digits are decimals: `decimals 2`":
        record Bad from fixed:
            amount: Decimal at "1..10"
    expect_compile_error "the prefix `cbc` is not declared":
        record Bad from xml:
            id: Text at "cbc:ID"
    expect_compile_error "without a header a column is its position":
        record Bad from csv(header=false):
            id: Text at "ID"
    expect_compile_error "`delimiter` is not an option of `csv` (sep, decimal, header, encoding)":
        record Bad from csv(delimiter=";"):
            id: Text
    expect_compile_error "`encoding` is \"utf-8\", \"latin1\"":
        record Bad from csv(encoding="ebcdic"):
            id: Text
    expect_compile_error "a pattern of dates":
        record Bad from csv:
            day: Date format "%Q"
    expect_compile_error "CSV is read row by row: `PosRow.parse_rows(text)`":
        let x = PosRow.parse("")
    expect_compile_error "`Invoice` is a record `from xml`: it is written with `xml()`":
        let inv = Invoice.parse("")
        let t = inv.json()
